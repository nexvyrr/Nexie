function internal.getCamlockView(currentCamera)
    local viewport = currentCamera.ViewportSize
    if viewport.X <= 0 or viewport.Y <= 0 then return nil end
    local character = player.Character
    local head = character and character:FindFirstChild("Head")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local origin = head and head:IsA("BasePart") and head.Position
        or root and root:IsA("BasePart") and (root.Position + Vector3.new(0, root.Size.Y * 0.5, 0))
        or currentCamera.CFrame.Position
    local fieldOfView = math.clamp(currentCamera.FieldOfView, 1, 120)
    local verticalLimit = math.tan(math.rad(fieldOfView) * 0.5)
    local focalLength = viewport.Y * 0.5 / verticalLimit
    local cameraFrame = currentCamera.CFrame
    return {
        ["Origin"] = origin,
        ["Forward"] = cameraFrame.LookVector,
        ["Right"] = cameraFrame.RightVector,
        ["Up"] = cameraFrame.UpVector,
        ["FocalLength"] = focalLength,
        ["HorizontalLimit"] = viewport.X * 0.5 / focalLength,
        ["VerticalLimit"] = verticalLimit,
    }
end
function internal.getCamlockTargetMetric(point, view)
    local offset = point - view.Origin
    local distance = offset.Magnitude
    if distance <= 0.001 then return nil end
    local mode = sharedState.camlockMode
    if mode == "360" then return distance end
    local depth = offset:Dot(view.Forward)
    if depth <= 0.001 then return nil end
    local horizontal = offset:Dot(view.Right) / depth
    local vertical = offset:Dot(view.Up) / depth
    local metric = horizontal * horizontal + vertical * vertical
    if mode == "FOV" then
        local radius = (tonumber(sharedState.camlockFOVRadius) or 120) / view.FocalLength
        return metric <= radius * radius and metric or nil
    end
    if math.abs(horizontal) > view.HorizontalLimit or math.abs(vertical) > view.VerticalLimit then
        return nil
    end
    return metric
end
function internal.isCamlockTargetValid(part, currentCamera, view)
    if not part or not part.Parent then return false end
    local character = part:FindFirstAncestorOfClass("Model")
    local owner = character and Players:GetPlayerFromCharacter(character)
    if not GameState.isEnemy(owner) or not internal.isSelectedTarget("Aimbot", owner) then return false end

function internal.setLightingOverride(property, value)
    local current = Lighting[property]
    if current == value then return end
    local entry = lightingOverrides[property]
    if not entry then
        entry = {["Original"] = current, ["Applied"] = nil}
        lightingOverrides[property] = entry
    end
    Lighting[property] = value
    entry.Applied = value
end
function internal.restoreLightingProperties()
    local restored = true
    for property, entry in pairs(lightingOverrides) do
        if Lighting[property] == entry.Applied then
            local ok = pcall(function() Lighting[property] = entry.Original end)
            if ok then
                lightingOverrides[property] = nil
            else
                restored = false
            end

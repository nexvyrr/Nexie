function internal.updateTargetHitboxes(deltaTime)
    if not sharedState.hitboxEnabled then
        hitboxUpdateAccumulator = 0
        return
    end
    hitboxUpdateAccumulator = hitboxUpdateAccumulator + deltaTime
    local interval = (sharedState.hitboxOnlyWithGun or sharedState.hitboxOnlyWithKnife) and 0.075 or 0.15
    if hitboxUpdateAccumulator < interval then
        return
    end
    hitboxUpdateAccumulator = 0
    if not internal.isHitboxWeaponAllowed() then
        internal.clearTargetHitboxes()
        return
    end
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player and targetPlayer.Character then
            local character = targetPlayer.Character
            local existingHitbox = sharedState.ownedHitboxes[character]
            if existingHitbox and existingHitbox.Parent ~= character then
                internal.removeTargetHitbox(character)
                existingHitbox = nil
            end
            if not GameState.isEnemy(targetPlayer) or not internal.isSelectedTarget("Hitbox", targetPlayer) then
                if existingHitbox then
                    internal.removeTargetHitbox(character)
                end
            else
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if rootPart and internal.isHitboxTargetVisible(character, rootPart) then
                    if not existingHitbox then
                        local hitboxPart = internal.newOwnedInstance("Part")
                        hitboxPart.Name = "TargetHitbox"
                        hitboxPart.Size = sharedState.hitboxSize
                        hitboxPart.Transparency = sharedState.hitboxTransparency
                        hitboxPart.CanCollide = false
                        hitboxPart.CanTouch = false
                        hitboxPart.Massless = true
                        hitboxPart.CFrame = rootPart.CFrame
                        hitboxPart.Parent = character
                        local hitboxWeld = internal.newOwnedInstance("WeldConstraint")
                        hitboxWeld.Part0 = rootPart
                        hitboxWeld.Part1 = hitboxPart
                        hitboxWeld.Parent = hitboxPart
                        internal.configureTargetHitboxShell(hitboxPart, true)
                        sharedState.ownedHitboxes[character] = hitboxPart
                    else
                        if existingHitbox.Size ~= sharedState.hitboxSize then
                            existingHitbox.Size = sharedState.hitboxSize
                            internal.configureTargetHitboxShell(existingHitbox, false)
                        end
                        if existingHitbox.Transparency ~= sharedState.hitboxTransparency then existingHitbox.Transparency = sharedState.hitboxTransparency end
                    end
                elseif existingHitbox then
                    internal.removeTargetHitbox(character)
                end
            end
        end
    end
    for character in pairs(sharedState.ownedHitboxes) do

            if not root or not root:IsA("BasePart")
                or (root.Position - localRoot.Position).Magnitude > ESP_SPECIAL_MAX_DISTANCE then
                label.Visible = false
            else
                local position = getSpecialEspNamePosition(camera, character:FindFirstChild("Head"), root)

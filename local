        sharedState.visualEnvironmentSyncing = false
        FeatureRegistry:SetActive("Lighting", false)
        internal.resetLightingPresetToOriginal()
        for _, field in ipairs({
            {"VisualClockTime", "ClockTime"},
            {"VisualBrightness", "Brightness"},
            {"VisualExposure", "ExposureCompensation"},
            {"VisualFogEnd", "FogEnd"},
            {"VisualAmbient", "Ambient"},
        }) do
            local current = field[2] == property and value or VVindUI:GetValue(field[1])
            if current ~= nil then FeatureRegistry:Invoke("Lighting", "ApplyProperty", field[2], current) end
        end
        return
    end
    FeatureRegistry:Invoke("Lighting", "ApplyProperty", property, value)
end

local function bulletSkinSetProperties(object, properties)
    for property, value in pairs(properties) do
        pcall(function() object[property] = value end)
    end
end
local function bulletSkinBuildPart(name)
    local definition = bulletSkinPresets[name]
    if not definition then return nil end
    local part = Instance.new("Part")
    part.Name = "SynergyBulletSkinVisual"
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    bulletSkinSetProperties(part, definition.Part)
    return part
end
local function bulletSkinAddVisuals(root, definition)
    local first = Instance.new("Attachment")
    first.Name = "SynergyBulletAttachment0"
    bulletSkinSetProperties(first, definition.Attach0)
    first.Parent = root
    local second = Instance.new("Attachment")
    second.Name = "SynergyBulletAttachment1"
    bulletSkinSetProperties(second, definition.Attach1)
    second.Parent = root
    local trail = Instance.new("Trail")
    trail.Name = "SynergyBulletTrail"
    bulletSkinSetProperties(trail, bulletSkinTrailDefaults)
    bulletSkinSetProperties(trail, definition.Trail)
    trail.Attachment0 = first
    trail.Attachment1 = second
    trail.LightEmission = 1
    trail.Lifetime = math.max(trail.Lifetime, 0.4)
    trail.Enabled = true
    trail.Parent = first
    local created = {first, second}
    for _, emitterDefinition in ipairs(definition.Emitters or {}) do
        local emitter = Instance.new("ParticleEmitter")
        emitter.Name = emitterDefinition.Name
        bulletSkinSetProperties(emitter, emitterDefinition.Props)
        emitter.Parent = root
        created[#created + 1] = emitter
    end
    return created, first, second
end
local function bulletSkinIsOwnOrigin(position)
    local character = player.Character
    if not character or not character.Parent then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root or (root.Position - position).Magnitude > 18 then return false end
    local distance = math.huge
    local equipped = false
    for _, tool in ipairs(character:GetChildren()) do
        if tool:IsA("Tool") then
            equipped = true
            local cached = bulletSkinState.ToolParts[tool]
            if not cached or #cached == 0 then
                cached = {}
                for _, descendant in ipairs(tool:GetDescendants()) do
                    if descendant:IsA("BasePart") then
                        local name = descendant.Name
                        if name == "Handle" or name == "GunDisplay" or name == "GunDisplay2" or name == "Muzzle" or name == "Barrel" then
                            cached[#cached + 1] = descendant
                        end
                    end
                end
                bulletSkinState.ToolParts[tool] = cached
            end
            for _, part in ipairs(cached) do
                if part:IsDescendantOf(tool) then
                    distance = math.min(distance, (part.Position - position).Magnitude)
                end
            end
        end
    end
    return equipped and distance <= 8
end
local function bulletSkinRestoreShot(shot)
    if not shot then return end
    for object, original in pairs(shot.Originals) do
        if object.Parent then pcall(function() object.Enabled = original end) end
    end
    if shot.Part and shot.Part.Parent and shot.PartProperties then
        bulletSkinSetProperties(shot.Part, shot.PartProperties)
    end
    for _, object in ipairs(shot.Created) do
        if object.Parent then pcall(function() object:Destroy() end) end
    end
end
local function bulletSkinApplyProjectile(part)
    if not bulletSkinState.Enabled or isDestroyed or not part.Parent then return end
    local definition = bulletSkinPresets[bulletSkinState.Selected]
    if not definition or not bulletSkinIsOwnOrigin(part.Position) then return end
    if bulletSkinState.Active[part] then return end
    local shot = {
        ["Originals"] = {}, ["Created"] = {}, ["Part"] = part,
        ["PartProperties"] = {
            ["Color"] = part.Color, ["Size"] = part.Size,
            ["Material"] = part.Material, ["Transparency"] = part.Transparency,
        },
    }
    bulletSkinState.Active[part] = shot
    bulletSkinSetProperties(part, definition.Part)
    for _, descendant in ipairs(part:GetDescendants()) do
        if descendant:IsA("Trail") or descendant:IsA("Beam") or descendant:IsA("ParticleEmitter") then
            shot.Originals[descendant] = descendant.Enabled
            descendant.Enabled = false
        end
    end
    local created = bulletSkinAddVisuals(part, definition)
    for _, item in ipairs(created) do shot.Created[#shot.Created + 1] = item end
    task.delay(3, function()
        if bulletSkinState.Active[part] == shot then bulletSkinState.Active[part] = nil end
    end)
end
local function bulletSkinApplyDefaultBeam(beam)
    if not bulletSkinState.Enabled or isDestroyed or not beam.Parent then return end
    if bulletSkinState.Active[beam] then return end
    local definition = bulletSkinPresets[bulletSkinState.Selected]
    local source = beam.Attachment0
    local destination = beam.Attachment1
    if not definition or not source or not destination or not bulletSkinIsOwnOrigin(source.WorldPosition) then return end
    local startPosition, endPosition = source.WorldPosition, destination.WorldPosition
    local direction = endPosition - startPosition
    if direction.Magnitude < 0.01 then return end
    local display = bulletSkinBuildPart(bulletSkinState.Selected)
    if not display then return end
    local shot = {["Originals"] = {[beam] = beam.Enabled}, ["Created"] = {display}}
    bulletSkinState.Active[beam] = shot
    beam.Enabled = false
    display.CFrame = CFrame.lookAt(startPosition, endPosition)
    local _, first, second = bulletSkinAddVisuals(display, definition)
    local offset = startPosition - (first.WorldPosition + second.WorldPosition) * 0.5
    display.CFrame = display.CFrame + offset
    local endFrame = CFrame.lookAt(endPosition, endPosition + direction) + offset
    local lifetime = math.max(direction.Magnitude / 450, 0.08)
    display.Parent = workspace
    game:GetService("Debris"):AddItem(display, lifetime + 0.6)
    game:GetService("TweenService"):Create(display, TweenInfo.new(lifetime, Enum.EasingStyle.Linear), {["CFrame"] = endFrame}):Play()
    task.delay(lifetime + 1, function()
        if bulletSkinState.Active[beam] == shot then bulletSkinState.Active[beam] = nil end
    end)
end
function internal.setBulletSkinsEnabled(enabled)
    enabled = enabled == true and not isDestroyed
    local state = bulletSkinState
    if state.Enabled == enabled then return end
    state.Enabled = enabled
    if enabled then
        state.Connection = workspace.DescendantAdded:Connect(function(descendant)
            if not state.Enabled or isDestroyed then return end
            if descendant:IsA("Part") and descendant.Parent == workspace and (
                bulletSkinPresets[descendant.Name] or (
                    descendant.Name == "Part" and descendant.Anchored and descendant.Transparency >= 0.99
                    and math.abs(descendant.Size.X - 0.1) < 0.001
                    and math.abs(descendant.Size.Y - 0.1) < 0.001
                    and math.abs(descendant.Size.Z - 0.1) < 0.001
                )
            ) then
                if state.Pending[descendant] then return end
                state.Pending[descendant] = true
                task.defer(function()
                    state.Pending[descendant] = nil
                    if state.Enabled then bulletSkinApplyProjectile(descendant) end
                end)
            elseif descendant:IsA("Beam") and descendant.Parent and descendant.Parent.Parent == workspace
                and descendant.Parent:IsA("Part") and descendant.Parent.Name == "Part"
                and descendant.FaceCamera and descendant.Attachment0 and descendant.Attachment1 then
                task.defer(function()
                    if state.Enabled then bulletSkinApplyDefaultBeam(descendant) end
                end)
            end
        end)
    else
        if state.Connection then state.Connection:Disconnect(); state.Connection = nil end
        table.clear(state.ToolParts)
        for shot in pairs(state.Active) do
            bulletSkinRestoreShot(state.Active[shot])
            state.Active[shot] = nil
        end
    end
end

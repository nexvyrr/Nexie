function Controller.Stop()
    if not Controller.Running then return true end
    Controller.Running = false
    Controller.Enabled = false
    cachedTarget = nil
    table.clear(targetCandidates)
    table.clear(Controller.CandidateIndices)
    for tool in pairs(Controller.Tools) do detachGunTool(tool) end
    for _, conn in ipairs(Controller.Connections) do pcall(function() conn:Disconnect() end) end
    table.clear(Controller.Connections)
    updateGunCursor(false)
    return true
end
if not weaponExecutorRestricted then
    internal.spawnTracked(function()
        if isDestroyed or not Controller.Running then return end
        resolveGunDependencies()
        if isDestroyed or not Controller.Running then return end
        observeGunContainer(player:FindFirstChildOfClass("Backpack"))
        observeGunContainer(player.Character)
        if isDestroyed or not Controller.Running then return end
        gunTrackConnection(player.CharacterAdded:Connect(function(character)
            updateGunCursor(false)
            observeGunContainer(character)
        end))
        gunTrackConnection(player.ChildAdded:Connect(function(child)
            if child:IsA("Backpack") then observeGunContainer(child) end
        end))
        if player.OnTeleport then
            gunTrackConnection(player.OnTeleport:Connect(function(state)
                if state == Enum.TeleportState.Started or state == Enum.TeleportState.InProgress then
                    Controller.Stop()
                end
            end))
        end
        while Controller.Running and not isDestroyed do
            task.wait(3)
            if not Controller.Running or isDestroyed then break end
            if resolveGunDependencies() then
                local containers = {}
                local backpack = player:FindFirstChildOfClass("Backpack")
                if backpack then containers[#containers + 1] = backpack end
                if player.Character then containers[#containers + 1] = player.Character end
                for _, container in ipairs(containers) do
                    for _, candidate in ipairs(container:GetChildren()) do
                        if verifyGunTool(candidate) and not Controller.Tools[candidate] then
                            attachGunTool(candidate)
                        end
                    end
                end
            end
        end
    end)
end

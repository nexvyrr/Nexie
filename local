function internal.shutdown(force)
    if isFullyStopped or isShuttingDown then return isFullyStopped end
    isShuttingDown = true
    internal.stopGodmode()
    local keepBackground = not force and not isDestroyed
        and (sharedState.silentAimManualEnabled or sharedState.autoShootEnabled or sharedState.autoMacro360.Enabled or espEnabled
            or sharedState.skeletonEspConfig.Enabled or avatarCleaner.Enabled)
    isDestroyed = not keepBackground
    sharedState.camlockFOVVisible = false
    if force then targetFilterUIActive = false end
    local stopOk, stopResult = pcall(FeatureRegistry.StopAll, FeatureRegistry, keepBackground and "soft" or "full")
    local clean = stopOk and stopResult == true
    if not stopOk then
        FeatureRegistry.Failures[#FeatureRegistry.Failures + 1] = {
            ["Feature"] = "Registry", ["Stage"] = "StopAll", ["Message"] = tostring(stopResult)
        }
    end
    if keepBackground then
        if not pcall(internal.syncRedirectHooks) then clean = false end
    else
        if instanceRegistry.__SynergyDmvsInstance == instanceController then
            if clean then instanceRegistry.__SynergyDmvsInstance = nil end
            _G.SNG_SCRIPT_READY = nil
        end
        isFullyStopped = clean
    end
    isShuttingDown = false
    return isFullyStopped
end

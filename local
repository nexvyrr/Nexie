    local function executorGet(send, url)
        if type(send) ~= "function" then return nil end
        local ok, response = pcall(send, {
            ["Url"] = url,
            ["Method"] = "GET",
            ["Headers"] = {["Accept"] = "application/json"},
            ["Timeout"] = 7
        })
        if not ok or type(response) ~= "table" or response.Success == false then return nil end
        local status = tonumber(response.StatusCode or response.Status or response.status or response.status_code)
        if status and (status < 200 or status >= 300) then return nil end
        local body = response.Body or response.body
        return type(body) == "string" and body ~= "" and body or nil
    end

    local function getFromExecutor(url)
        return executorGet(request, url)
            or executorGet(http_request, url)
            or executorGet(syn and syn.request, url)
            or executorGet(http and http.request, url)
    end

    local function getBanlist()
        local body = getFromExecutor(banUrl)
        if not body then
            local ok, result = pcall(function() return game:HttpGet(banUrl) end)
            if ok and type(result) == "string" then body = result end
        end
        if not body then return nil end
        local ok, decoded = pcall(function() return httpService:JSONDecode(body) end)
        return ok and type(decoded) == "table" and decoded or nil
    end

    local function inBanlist(entries, value)
        if type(entries) ~= "table" or value == nil then return false end
        local target = tostring(value)
        for _, entry in pairs(entries) do
            if (type(entry) == "string" or type(entry) == "number") and tostring(entry) == target then
                return true
            end
        end
        return false
    end

    local function getHardwareId()
        local getter = type(gethwid) == "function" and gethwid or nil
        if not getter and type(getgenv) == "function" then
            local ok, env = pcall(getgenv)
            if ok and type(env) == "table" and type(env.gethwid) == "function" then
                getter = env.gethwid
            end
        end
        if not getter then return nil end
        local ok, result = pcall(getter)
        if not ok or type(result) ~= "string" then return nil end
        return result:match("^%s*(.-)%s*$")
    end

    local function getPublicIp(url)
        local body = getFromExecutor(url)
        if not body then return nil end
        local ok, result = pcall(function() return httpService:JSONDecode(body) end)
        if not ok or type(result) ~= "table" or type(result.ip) ~= "string" then return nil end
        local ip = result.ip:match("^%s*(.-)%s*$")
        return #ip >= 3 and #ip <= 45 and ip or nil
    end

    local banlist = getBanlist()
    if banlist then
        local banned = inBanlist(banlist.userIds, player.UserId)
            or inBanlist(banlist.hwids, getHardwareId())
        if not banned and type(banlist.ips) == "table" then
            local checkV4, checkV6 = false, false
            for _, ip in pairs(banlist.ips) do
                if type(ip) == "string" and ip:find(":", 1, true) then
                    checkV6 = true
                elseif type(ip) == "string" then
                    checkV4 = true
                end
            end
            if checkV4 then
                banned = inBanlist(banlist.ips, getPublicIp("https://api.ipify.org?format=json"))
            end
            if not banned and checkV6 then
                banned = inBanlist(banlist.ips, getPublicIp("https://api6.ipify.org?format=json"))
                    or inBanlist(banlist.ips, getPublicIp("https://api64.ipify.org?format=json"))
            end
        end
        if banned then
            player:Kick("Banned Of The Script!\n\nSupport: discord.gg/synergyteam")
            return
        end
    end

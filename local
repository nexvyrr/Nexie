local bridgeOnce = setmetatable({}, {["__mode"] = "k"})
local function gunEmitterValid(remote)
    return typeof(remote) == "Instance"
        and remote:IsA("RemoteEvent") and remote.Parent ~= nil
end
local function isGunKillCandidate(remote)
    if not gunEmitterValid(remote) then return false end
    local packages = ReplicatedStorage:FindFirstChild("Packages")
    local netFolder = packages and packages:FindFirstChild("Net")
    if not netFolder or remote.Parent ~= netFolder then return false end
    local name = remote.Name
    return name == "RE/GunKill" or (type(name) == "string"
        and name:match("^RE/%x+$") and #name == 67)
end
local function getGunFunctionUpvalues(fn)
    if type(debug) ~= "table" then return nil end
    if type(debug.getupvalues) == "function" then
        local ok, result = pcall(debug.getupvalues, fn)
        if ok and type(result) == "table" and next(result) ~= nil then return result end
    end
    if type(debug.getupvalue) == "function" then
        local result = {}
        for i = 1, 32 do
            local ok, a, b = pcall(debug.getupvalue, fn, i)
            if not ok or a == nil then break end
            local value = b ~= nil and b or a
            result[i] = value
        end
        return result
    end
    return nil
end
local function captureSessionGunKill(tool)
    local finishReason = nil
    local allCandidates = {}
    local countCandidates = 0
    local seenCandidates = {}
    local seenFunctions = {}
    local queue = {}
    local queueSize = 0
    local scanned = 0
    local getConnections = getconnections
    if type(getConnections) ~= "function" then
        finishReason = "getconnections unavailable in this executor"
    elseif type(debug) ~= "table" or (type(debug.getupvalues) ~= "function"
        and type(debug.getupvalue) ~= "function") then
        finishReason = "debug.getupvalues/getupvalue unavailable"
    end
    local function offer(remote)
        if isGunKillCandidate(remote) and not seenCandidates[remote] then
            seenCandidates[remote] = true
            countCandidates += 1
            allCandidates[countCandidates] = remote
        end
    end
    local function enqueue(fn, depth)
        if type(fn) ~= "function" or seenFunctions[fn] then return end
        if depth > 5 or queueSize >= 96 then return end
        seenFunctions[fn] = true
        queueSize += 1
        queue[queueSize] = {["Fn"] = fn, ["Depth"] = depth}
    end
    if not finishReason then
        local ok, connections = pcall(getConnections, tool.Activated)
        if not ok or type(connections) ~= "table" then
            finishReason = "getconnections(Activated) returned no usable list: " .. tostring(connections)
        else
            for _, connection in ipairs(connections) do
                local okFn, fn = pcall(function()
                    return connection.Function or connection.Callback
                end)
                if okFn then enqueue(fn, 0) end
            end
            if queueSize == 0 then
                finishReason = "Activated connection functions hidden by executor"
            end
        end
    end
    if not finishReason then
        local i = 1
        while i <= queueSize and scanned < 96 do
            local entry = queue[i]
            i += 1
            scanned += 1
            local values = getGunFunctionUpvalues(entry.Fn)
            if type(values) == "table" then
                local uvCount = 0
                for _, val in pairs(values) do
                    uvCount += 1
                    if uvCount > 48 then break end
                    if typeof(val) == "Instance" then
                        offer(val)
                    elseif type(val) == "function" then
                        enqueue(val, entry.Depth + 1)
                    elseif type(val) == "table" and entry.Depth < 5 then
                        local okSend, send = pcall(function()
                            return rawget(val, "FireServer")
                        end)
                        if okSend then enqueue(send, entry.Depth + 1) end
                        local mt = getmetatable(val)
                        if type(mt) == "table" then
                            local index = rawget(mt, "__index")
                            if type(index) == "table" then
                                enqueue(rawget(index, "FireServer"), entry.Depth + 1)
                            end
                        end
                    end
                end
            end
        end
        if countCandidates == 0 then
            finishReason = "no Net RE/hash captured in Activated closure tree"
        elseif countCandidates > 1 then
            finishReason = "ambiguous: " .. countCandidates .. " Net event candidates; refuse to guess"
        end
    end
    if finishReason then return false end
    gunKillRemote = allCandidates[1]
    Controller.HitRouteReady = true
    return true
end
local function refreshGunKillRoute(tool)
    if Controller.HitRouteReady and gunEmitterValid(gunKillRemote) then
        return true
    end
    Controller.HitRouteReady = false
    gunKillRemote = nil
    if not tool or not tool:IsA("Tool") then return false end
    local original = tool:FindFirstChild("LocalScript")
    if not original or not original:IsA("LocalScript") then
        return false
    end
    local prior = bridgeOnce[tool]
    if prior and prior.Script == original then
        if prior.Attempts >= 3 then return false end
        if os.clock() < prior.NextRetryAt then return false end
    end
    local attempts = prior and prior.Script == original and prior.Attempts + 1 or 1
    bridgeOnce[tool] = {["Script"] = original, ["Attempts"] = attempts, ["NextRetryAt"] = os.clock() + 2.5}
    return captureSessionGunKill(tool)
end
local function resolveGunDependencies()
    if Controller.DependenciesReady and gunMatchState then return true end
    local client = ReplicatedStorage:FindFirstChild("Client")
    local modules = client and client:FindFirstChild("Modules")
    if not gunMatchState then
        gunMatchState = gunTryRequire(modules and modules:FindFirstChild("MatchState"))
    end
    if type(gunMatchState) ~= "table"
        or type(gunMatchState.getGame) ~= "function"
        or type(gunMatchState.sameGame) ~= "function"
        or type(gunMatchState.sameTeam) ~= "function" then
        Controller.DependenciesReady = false
        return false
    end
    local bindables = ReplicatedStorage:FindFirstChild("BindableEvents")
    local beam = bindables and bindables:FindFirstChild("LocalBeam")
    gunLocalBeam = beam and beam:IsA("BindableEvent") and beam or nil
    if not gunMouseIcon then
        gunMouseIcon = gunTryRequire(modules and modules:FindFirstChild("MouseIcon"))
    end
    Controller.DependenciesReady = true
    return true
end
local gunExcluded = {}
local function buildGunExclusions(character, mapName, localGameId)
    table.clear(gunExcluded)
    gunExcluded[1] = character
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player and other.Character then
            local ok, skip = pcall(function()
                if gunMatchState.sameTeam(other, player) then return true end
                local otherMap = gunMatchState.getMapName(other)
                local otherGame = gunMatchState.getGameId(other)
                return otherMap ~= nil and otherMap == mapName
                    and (otherGame or "nothing") ~= localGameId
            end)
            if ok and skip then
                gunExcluded[#gunExcluded + 1] = other.Character
            end
        end
    end
end
local function raycastGun(origin, targetPoint, character, macroContext)
    local travel = targetPoint - origin
    if travel.Magnitude < 0.001 then return nil, origin, "zero_direction" end
    local direction = travel.Unit * 10000
    local mapModel
    if macroContext then
        table.clear(gunExcluded)
        for i, excluded in ipairs(macroContext.Exclusions) do gunExcluded[i] = excluded end
        mapModel = macroContext.MapModel
    else
        local gameId = gunMatchState.getGameId(player)
        local mapName = gunMatchState.getMapName(player)
        buildGunExclusions(character, mapName, gameId)
        local maps = workspace:FindFirstChild("ActiveMaps")
        local matchId = gunMatchState.getMatchId(player)
        mapModel = maps and matchId and maps:FindFirstChild(tostring(matchId)) or nil
    end
    local result
    for _ = 1, MAX_RAY_PASSTHROUGHS do
        gunRayParams.FilterDescendantsInstances = gunExcluded
        result = workspace:Raycast(origin, direction, gunRayParams)
        if result and mapModel and result.Instance.Transparency >= 1
            and result.Instance:IsDescendantOf(mapModel) then
            gunExcluded[#gunExcluded + 1] = result.Instance
        else
            local hitPos = result and result.Position or origin + direction
            return result, hitPos, nil
        end
    end
    return nil, nil, "transparent_pass_budget_exceeded"
end
local function findHitPlayer(hitPart)
    local ancestor = hitPart
    while ancestor and ancestor ~= workspace do
        if ancestor:IsA("Model") then
            local other = Players:GetPlayerFromCharacter(ancestor)
            if other then return other, ancestor end
        end
        ancestor = ancestor.Parent
    end
    return nil, nil
end

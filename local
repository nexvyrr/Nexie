    local frame = bodyPart.CFrame
    local origin = frame:PointToObjectSpace(ray.Origin)
    local direction = frame:VectorToObjectSpace(ray.Direction)
    local halfSize = bodyPart.Size * 0.5
    local near, far = 0, 2000
    for _, axis in ipairs(triggerRayAxes) do
        local position = origin[axis]
        local velocity = direction[axis]
        local extent = halfSize[axis]
        if math.abs(velocity) < 0.000001 then
            if math.abs(position) > extent then return nil end
        else
            local enter = (-extent - position) / velocity
            local leave = (extent - position) / velocity
            if enter > leave then enter, leave = leave, enter end
            near = math.max(near, enter)

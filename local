function internal.createTab(id, titleKey, icon)
    local definitions = TAB_LAYOUTS[id]
    local tab = Window:AddTab({["Name"] = VVindUI:Translate(titleKey), ["NameKey"] = titleKey, ["Icon"] = "Lucide:" .. icon})
    local state = {["pages"] = {}, ["sectionToPage"] = {}}
    for _, definition in ipairs(definitions) do
        local page = #definitions == 1 and tab or tab:AddSubTab({
            ["Name"] = VVindUI:Translate(definition.name),
            ["NameKey"] = definition.name,
            ["Icon"] = "Lucide:" .. definition.icon,
        })
        state.pages[definition.id] = page
        for _, sectionKey in ipairs(definition.sections) do
            state.sectionToPage[sectionKey] = definition.id
        end
    end
    tabPages[id] = state
end
function internal.createSection(id, name, icon, subpageId)
    local layout = tabPages[id]
    local pageId = subpageId or layout.sectionToPage[name]
    local page = layout.pages[pageId]
    return page:AddSection({
        ["Text"] = VVindUI:Translate(name),
        ["TextKey"] = name,
        ["Icon"] = "Lucide:" .. icon,
    })
end

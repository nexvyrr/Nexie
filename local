local function normalizeAutoShootBodySelection(selection, previous, isInitialization)
    local values, seen = {}, {}
    local valid = {}
    for _, option in ipairs(targetPartOptions) do valid[option.Value] = true end
    if type(selection) == "table" then
        for _, value in ipairs(selection) do
            if valid[value] and not seen[value] then
                seen[value] = true
                values[#values + 1] = value
            end
        end
    end
    if seen["Full Body"] and #values > 1 then
        local previouslyFull = not isInitialization and type(previous) == "table"
            and table.find(previous, "Full Body") ~= nil
        local addedSpecific = false
        if previouslyFull then
            for _, value in ipairs(values) do
                if value ~= "Full Body" and not table.find(previous, value) then
                    addedSpecific = true
                    break
                end
            end
        end
        if not addedSpecific then return {"Full Body"} end
        local specific = {}
        for _, value in ipairs(values) do
            if value ~= "Full Body" then specific[#specific + 1] = value end
        end
        return specific
    end
    return values
end

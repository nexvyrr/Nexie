function internal.stopModeratorWatch()
    moderatorWatch.Active = false
    local dialog = moderatorWatch.Dialog
    moderatorWatch.Dialog = nil
    moderatorWatch.Showing = false
    if dialog and type(dialog.Close) == "function" then
        pcall(dialog.Close, false)
    end
end

function internal.startModeratorWatch()
    if moderatorWatch.Active or isDestroyed then return end
    moderatorWatch.Active = true
    local function inspectPlayers()
        if isDestroyed or not moderatorWatch.Active or moderatorNotice.Dismissed or moderatorWatch.Showing then return end
        for _, targetPlayer in ipairs(Players:GetPlayers()) do
            if targetPlayer ~= player and targetPlayer.Parent == Players then
                local detected, role = isGameModerator(targetPlayer)
                if detected then
                    showModeratorPrompt(targetPlayer, role)
                    return
                end
            end
        end
    end
    inspectPlayers()
    internal.spawnTracked(function()
        while moderatorWatch.Active and not isDestroyed do
            task.wait(2)
            if not moderatorWatch.Active or isDestroyed then break end
            inspectPlayers()
        end
    end)
end


local function detachGunTool(tool)
    local entry = Controller.Tools[tool]
    if not entry then return end
    for _, connection in ipairs(entry) do pcall(function() connection:Disconnect() end) end
    Controller.Tools[tool] = nil
    Controller.TouchHits[tool] = nil
end
local function attachGunTool(tool)
    if weaponExecutorRestricted or not Controller.Running or not verifyGunTool(tool) or Controller.Tools[tool] then return end
    local character = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")
    if tool.Parent ~= character and tool.Parent ~= backpack then return end
    if not resolveGunDependencies() or isDestroyed or not Controller.Running then
        internal.debugLog("Gun", "attach", "Tool not attached: gun dependencies missing or controller stopped", 4)
        return
    end
    if not refreshGunKillRoute(tool) or isDestroyed or not Controller.Running then
        internal.debugLog("Gun", "attach", "Tool not attached: GunKill route discovery failed", 4)
        return
    end
    local entry = {}
    Controller.Tools[tool] = entry
    local function register(signal, callback)
        local conn = signal:Connect(callback)
        entry[#entry + 1] = conn
        return conn
    end
    register(tool.Activated, function() protectShot(tool) end)
    register(tool.Equipped, function()
        updateGunCursor(true)
        local ting = tool:FindFirstChild("Ting")
        if ting and ting:IsA("Sound") then pcall(function() ting:Play() end) end
    end)
    register(tool.Unequipped, function() updateGunCursor(false) end)
    if UserInputService.TouchEnabled then
        register(gunMouse.Button1Down, function()
            if tool.Parent == player.Character then
                Controller.TouchHits[tool] = gunMouse.Hit.Position
            end
        end)
    end
    register(tool.Destroying, function() detachGunTool(tool) end)
    local old = tool:FindFirstChild("LocalScript")
    if old and old:IsA("LocalScript") then
        local ok = internal.debugProtected("Gun", "OldLocalScript", function() old:Destroy() end)
        if not ok then
            detachGunTool(tool)
            return
        end
    end
    if tool.Parent == character then updateGunCursor(true) end
    internal.debugLog("Gun", "attach", "Tool attached to rebuilt gun controller: " .. tool.Name, 4)
end
local function checkNewGun(child)
    if not Controller.Running or not child or not child:IsA("Tool") then return end
    if verifyGunTool(child) then
        attachGunTool(child)
    else
        local conn
        conn = child.ChildAdded:Connect(function()
            if not Controller.Running then conn:Disconnect(); return end
            if verifyGunTool(child) then
                conn:Disconnect()
                attachGunTool(child)
            end
        end)
        gunTrackConnection(conn)
    end
end
local observedGunContainers = setmetatable({}, {["__mode"] = "k"})
local function observeGunContainer(container)
    if not container or isDestroyed or not Controller.Running or observedGunContainers[container] then return end
    observedGunContainers[container] = true
    gunTrackConnection(container.ChildAdded:Connect(checkNewGun))
    for _, tool in ipairs(container:GetChildren()) do
        if isDestroyed or not Controller.Running then break end
        checkNewGun(tool)
    end
end

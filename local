function GameState.getTargetSnapshots(skipPositionRefresh)
    local state = GameState.Targets
    local now = os.clock()
    if skipPositionRefresh and now < state.ExpiresAt then return state.List end
    local localRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local localPosition = localRoot and localRoot.Position
    if now < state.ExpiresAt then
        if not skipPositionRefresh and state.PositionFrame ~= state.FrameId then
            for _, info in ipairs(state.List) do
                info.Position = info.Root and info.Root.Position or nil
                info.DistanceToLocal = localPosition and info.Position and (info.Position - localPosition).Magnitude or nil
            end
            state.PositionFrame = state.FrameId
        end
        return state.List
    end
    local list, entries = state.List, state.Entries
    table.clear(list)
    state.Revision += 1
    local revision = state.Revision
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player then
            local character = targetPlayer.Character
            local previous = state.Entries[targetPlayer]
            local info
            if previous and previous.Character == character then
                info = previous
            else
                info = {["Player"] = targetPlayer, ["Character"] = character}
            end
            info.Root = character and character:FindFirstChild("HumanoidRootPart")
            info.Head = character and character:FindFirstChild("Head")
            info.Humanoid = character and character:FindFirstChildOfClass("Humanoid")
            info.Position = info.Root and info.Root.Position or nil
            info.DistanceToLocal = localPosition and info.Position and (info.Position - localPosition).Magnitude or nil
            info.EnemyCheckedAt = nil
            info.Revision = revision
            list[#list + 1] = info
            entries[targetPlayer] = info
        end
    end
    for targetPlayer, info in pairs(entries) do
        if info.Revision ~= revision then entries[targetPlayer] = nil end
    end
    state.ExpiresAt = now + 0.04
    state.PositionFrame = state.FrameId
    return list
end


function internal.updateEspNames()
    if isDestroyed then return end
    local camera = workspace.CurrentCamera
    local localCharacter = player.Character
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
    local visiblePlayers = {}
    if camera and localRoot then
        for targetPlayer in pairs(espSpecialPresent) do
            local _, root, head = getVisibleEspSpecial(targetPlayer, localRoot)
            if root then
                local position = getSpecialEspNamePosition(camera, head, root)
                if position and showEspLabel(targetPlayer, position, true) then
                    visiblePlayers[targetPlayer] = true
                end
            end
        end
        if espEnabled and ESP_CONFIG.ShowName then
            for _, info in ipairs(internal.getTargetSnapshots()) do
                local targetPlayer = info.Player
                local isTeammate = ESP_CONFIG.ShowTeammates and internal.isEspTeammate(targetPlayer)
                if (isTeammate or (not espSpecialPresent[targetPlayer]
                    and internal.isSnapshotEnemy(info)
                    and internal.isSelectedTarget("ESP", targetPlayer)))
                    and info.DistanceToLocal and info.DistanceToLocal <= 300 then
                    local root = info.Root
                    if root and root:IsA("BasePart") then
                        local head = info.Head
                        local anchor = head and head:IsA("BasePart")
                            and (head.Position + Vector3.new(0, head.Size.Y * 0.6 + 0.5, 0))
                            or (root.Position + Vector3.new(0, 3, 0))
                        local point, isVisible = camera:WorldToViewportPoint(anchor)
                        if isVisible and point.Z > 0
                            and showEspLabel(targetPlayer, UDim2.fromOffset(point.X, point.Y), false, isTeammate) then
                            visiblePlayers[targetPlayer] = true
                        end
                    end
                end
            end
        end
    end
    for targetPlayer, label in pairs(espNameLabels) do
        if targetPlayer.Parent ~= Players
            or (not espSpecialPresent[targetPlayer] and (not espEnabled or not ESP_CONFIG.ShowName)) then
            label:Destroy()
            espNameLabels[targetPlayer] = nil
        elseif not visiblePlayers[targetPlayer] and label.Visible then
            label.Visible = false
        end
    end
end
function internal.updateESP()
    if isDestroyed then return end
    local eligible = {}
    if internal.Debug.Enabled then
        internal.debugLog("ESP", "state", "ESP enabled=" .. tostring(espEnabled) .. ", role targets=" .. tostring(next(espSpecialPresent) ~= nil), 6)
    end
    local localCharacter = player.Character
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
    if not localRoot and next(espSpecialPresent) then
        internal.debugLog("ESP", "local-root", "Special ESP cannot update: local HumanoidRootPart is missing", 4)
    end
    if localRoot then
        for targetPlayer in pairs(espSpecialPresent) do
            local character, root = getVisibleEspSpecial(targetPlayer, localRoot)
            if character and root then
                eligible[targetPlayer] = true
                local highlight = internal.acquireEspHighlight(targetPlayer, character)
                if highlight and not internal.applyEspHighlight(highlight, character, targetPlayer) then
                    internal.releaseEspHighlight(targetPlayer, true)
                end
            end
        end
    end
    if espEnabled then
        local filter = sharedState.targetFilters.ESP
        local onlySelectedEnabled = filter and filter.OnlySelected == true
        local uiSelectionValue = VVindUI:GetValue("ESPOnlySelected")
        if filter and type(uiSelectionValue) == "boolean" and uiSelectionValue ~= onlySelectedEnabled then
            filter.OnlySelected = uiSelectionValue
            onlySelectedEnabled = uiSelectionValue
        end
        for _, info in ipairs(internal.getTargetSnapshots()) do
            local targetPlayer = info.Player
            local isTeammate = ESP_CONFIG.ShowTeammates and internal.isEspTeammate(targetPlayer)
            if (isTeammate or (not espSpecialPresent[targetPlayer]
                and internal.isSnapshotEnemy(info)
                and (not onlySelectedEnabled or internal.isSelectedTarget("ESP", targetPlayer)))) then
                local character = info.Character
                local root = info.Root
                if character and character.Parent and root and root:IsA("BasePart") then
                    eligible[targetPlayer] = true
                    local highlight = internal.acquireEspHighlight(targetPlayer, character)
                    if highlight and not internal.applyEspHighlight(highlight, character, targetPlayer, isTeammate) then
                        internal.releaseEspHighlight(targetPlayer, true)
                    end
                else
                    internal.debugLog("ESP", "skipped:" .. targetPlayer.UserId, targetPlayer.Name .. ": Character or HumanoidRootPart unavailable", 5)
                end
            elseif internal.Debug.Enabled and not espSpecialPresent[targetPlayer] then
                internal.debugLog("ESP", "skipped:" .. targetPlayer.UserId,
                    targetPlayer.Name .. ": Filtered out (team, match, selection, or snapshot validity)", 6)
            end
        end
    end
    for targetPlayer in pairs(espOwnedHighlights) do
        if not eligible[targetPlayer] then
            internal.debugLog("ESP", "released:" .. targetPlayer.UserId, targetPlayer.Name .. ": Highlight released because target is no longer eligible", 4)
            internal.releaseEspHighlight(targetPlayer)
        end
    end
end

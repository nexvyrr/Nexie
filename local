                for object, nextTouch in pairs(state.Pending) do
                    if not state.Enabled or state.Session ~= session or isDestroyed then break end
                    if object.Parent ~= state.Folder then
                        state.Pending[object] = nil
                    elseif now >= nextTouch then
                        local touch = object.PrimaryPart
                        if touch then
                            state.Pending[object] = now + 0.5
                            pcall(function()
                                firetouchinterest(root, touch, 0)

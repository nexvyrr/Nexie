local autoMacroRayContext = {["Character"] = nil, ["ExpiresAt"] = 0, ["Data"] = nil}
function internal.isAutoMacroShotPathClear(targetCharacter, point)
    if not Controller.Running or not targetCharacter or not internal.isFiniteTargetVector(point) then return false end
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not resolveGunDependencies() then return false end
    local ok, hitCharacter = internal.debugProtected("Auto Macro", "Raycast", function()
        local now = os.clock()
        local context = autoMacroRayContext.Data
        if autoMacroRayContext.Character ~= character or now >= autoMacroRayContext.ExpiresAt then
            local gameId = gunMatchState.getGameId(player)
            local mapName = gunMatchState.getMapName(player)
            buildGunExclusions(character, mapName, gameId)
            local maps = workspace:FindFirstChild("ActiveMaps")
            local matchId = gunMatchState.getMatchId(player)
            context = {
                ["Exclusions"] = table.clone(gunExcluded),
                ["MapModel"] = maps and matchId and maps:FindFirstChild(tostring(matchId)) or nil
            }
            autoMacroRayContext.Character = character
            autoMacroRayContext.Data = context
            autoMacroRayContext.ExpiresAt = now + 0.025
        end
        local result = raycastGun(root.Position, point, character, context)
        if not result then return nil end
        local _, victimCharacter = findHitPlayer(result.Instance)
        return victimCharacter
    end)
    return ok and hitCharacter == targetCharacter
end
local function getBaseGunAim(tool, character)
    local baseAim = Controller.TouchHits[tool] or gunMouse.Hit.Position
    if sharedState.macroBusy and sharedState.macroActiveGun == tool
        and internal.isFiniteTargetVector(sharedState.macroTouchAimPoint) then
        baseAim = sharedState.macroTouchAimPoint
    end
    local macro = sharedState.autoMacro360
    if macro.Enabled and macro.Busy and macro.ActiveGun == tool and macro.CurrentTarget then
        if not macro.ShotMiss then
            local point = internal.resolveAutoMacroAimPoint(macro.CurrentTarget)
            if internal.isFiniteTargetVector(point) then
                return point
            end
        end
        return baseAim
    end
    if sharedState.autoShootEnabled and os.clock() <= sharedState.autoShootFireUntil then
        local selectedPart = sharedState.autoShootTarget
        local point = sharedState.autoShootAimPoint
        if not sharedState.autoShootMiss and selectedPart and selectedPart.Parent
            and internal.isFiniteTargetVector(point) then
            return point
        end
        return baseAim
    end
    if Controller.Enabled then
        local hitChance = math.clamp(tonumber(sharedState.silentAimHitChance) or 100, 0, 100)
        if math.random(1, 100) <= hitChance then
            local root = character:FindFirstChild("HumanoidRootPart")
            if root then
                local point, target = pickTarget(gunMatchState, root.Position)
                if target and internal.isFiniteTargetVector(point) then
                    internal.debugLog("Silent Aim", "shot", "Shot aim redirected to " .. target.Name, 2)
                    return point, "silent"

                end
            else
                internal.debugLog("Silent Aim", "shot", "Cannot redirect: local HumanoidRootPart is missing", 3)
            end
            internal.debugLog("Silent Aim", "shot", "Shot kept normal trajectory because no valid target was selected", 3)
        else
            internal.debugLog("Silent Aim", "shot", "Shot kept normal trajectory because the hit-chance roll failed (" .. tostring(hitChance) .. "%)", 3)
        end
        return baseAim
    end
    return baseAim
end
local function verifyGunTool(tool)
    return tool and tool:IsA("Tool")
        and tool:FindFirstChild("Handle") and tool.Handle:IsA("BasePart")
        and tool:FindFirstChild("fire") and tool.fire:IsA("RemoteEvent")
        and tool:FindFirstChild("showBeam") and tool.showBeam:IsA("RemoteEvent")
end
local function fireRebuiltGun(tool)
    if not Controller.Running or isDestroyed then
        internal.debugLog("Gun", "blocked", "Shot rejected: controller is stopped or shutting down", 3)
        return
    end
    if not verifyGunTool(tool) then
        internal.debugLog("Gun", "blocked", "Shot rejected: tool lacks Handle, fire, or showBeam", 3)
        return
    end
    local character = player.Character
    if tool.Parent ~= character then
        internal.debugLog("Gun", "blocked", "Shot rejected: gun is not equipped", 3)
        return
    end
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not root then
        internal.debugLog("Gun", "blocked", "Shot rejected: character is dead or root is missing", 3)
        return
    end
    if not resolveGunDependencies() then
        internal.debugLog("Gun", "blocked", "Shot rejected: gun dependencies are unavailable", 3)
        return
    end
    local gameState = gunMatchState.getGame(player)
    if not gameState or gameState.RoundStarted ~= false or gameState.CurrentRoundEnded ~= false then
        internal.debugLog("Gun", "blocked", "Shot rejected: round state is not valid for firing", 3)
        return
    end
    local now = os.clock()
    local lastTime = Controller.LastShot[tool]
    if lastTime and now - lastTime < GUN_COOLDOWN then
        internal.debugLog("Gun", "blocked", "Shot rejected: gun cooldown active", 3)
        return
    end
    local origin = root.Position
    local point, shotSource = getBaseGunAim(tool, character)
    if not shotSource then
        shotSource = sharedState.macroBusy and "macro" or (sharedState.autoMacro360.Busy and "auto macro")
            or (sharedState.autoShootEnabled and os.clock() <= sharedState.autoShootFireUntil and "auto shoot")
            or (Controller.Enabled and "normal or silent aim fallback") or "normal aim"
    end
    if not internal.isFiniteTargetVector(point) then
        internal.debugLog("Gun", "blocked", "Shot rejected: invalid aim vector from " .. tostring(shotSource or "base aim"), 3)
        return
    end

    local hit, position = raycastGun(origin, point, character)
    if not position then
        internal.debugLog("Gun", "blocked", "Shot rejected: weapon raycast returned no valid endpoint", 3)
        return
    end
    Controller.LastShot[tool] = now
    local handle = tool.Handle
    if gunLocalBeam then
        internal.debugProtected("Gun", "LocalBeam", function() gunLocalBeam:Fire(handle, position) end)
    end
    tool.fire:FireServer()
    tool.showBeam:FireServer(position, origin, handle)
    internal.debugLog("Gun", "fired", "Fire and showBeam remotes sent; source=" .. tostring(shotSource)
        .. (hit and (" | hit=" .. hit.Instance.Name) or " | raycast missed"), 2)
    local targetPlayer, targetCharacter
    if hit then targetPlayer, targetCharacter = findHitPlayer(hit.Instance) end
    if not targetPlayer or not targetCharacter or targetPlayer == player then
        internal.debugLog("Gun", "hit", "No enemy player hit; GunKill was not sent", 3)
        return
    end
    local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
    if not targetHumanoid or targetHumanoid.Health <= 0 then
        internal.debugLog("Gun", "hit", targetPlayer.Name .. ": hit rejected because target is dead or missing Humanoid", 3)
        return
    end
    if not gunMatchState.sameGame(targetPlayer, player) or gunMatchState.sameTeam(targetPlayer, player) then
        internal.debugLog("Gun", "hit", targetPlayer.Name .. ": GunKill suppressed by game or team check", 3)
        return
    end
    if not Controller.HitRouteReady or not gunEmitterValid(gunKillRemote) then
        internal.debugLog("Gun", "hit", "GunKill remote is missing or hit route is not ready", 3)
        return
    end
    local look = position - handle.Position
    if look.Magnitude < 0.001 then return end
    local lookVector = look.Unit
    local sent = internal.debugProtected("Gun", "GunKill", function()
        gunKillRemote:FireServer(GUN_KILL_SIGNATURE, targetPlayer, lookVector, origin, position)
    end)
    if sent then
        internal.debugLog("Gun", "gunkill", "GunKill remote sent for " .. targetPlayer.Name .. "; server hit not confirmed", 2)
    end
end
local function protectShot(tool)

local function isGameModerator(targetPlayer)
    if targetPlayer == player then return false end
    if CollectionService:HasTag(targetPlayer, "Admin") then return true, "Admin" end
    local rank = targetPlayer:GetAttribute("Admin")
    if rank == true then return true, "Admin" end
    if type(rank) ~= "string" then return false end
    local normalized = rank:match("^%s*(.-)%s*$"):lower()
    if normalized == "" or normalized == "none" or normalized == "false"
        or normalized == "0" or normalized == "user" or normalized == "player"
        or normalized == "member" or normalized == "guest" then
        return false
    end
    return true, rank
end

local function getPublicServerResponse(url)
    local requestFunctions = {}
    if type(request) == "function" then requestFunctions[#requestFunctions + 1] = request end
    if type(http_request) == "function" then requestFunctions[#requestFunctions + 1] = http_request end
    if type(syn) == "table" and type(syn.request) == "function" then
        requestFunctions[#requestFunctions + 1] = syn.request
    end
    for _, requestFunction in ipairs(requestFunctions) do
        if type(requestFunction) == "function" then
            local ok, response = pcall(requestFunction, {["Url"] = url, ["Method"] = "GET"})
            if ok and type(response) == "table"
                and (response.Success == nil or response.Success == true)
                and (not response.StatusCode or tonumber(response.StatusCode) == 200)
                and type(response.Body) == "string" then
                return response.Body
            end
        end
    end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok and type(body) == "string" then return body end
    return nil
end

local function findAnotherPublicServer()
    local httpService = game:GetService("HttpService")
    local api = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId)
        .. "/servers/Public?limit=100&sortOrder=Asc"
    local cursor
    local candidates = {}
    for _ = 1, 3 do
        if isDestroyed or not moderatorWatch.Active then return nil end
        local url = api .. (cursor and ("&cursor=" .. httpService:UrlEncode(cursor)) or "")
        local body = getPublicServerResponse(url)
        if not body then break end
        local ok, data = pcall(httpService.JSONDecode, httpService, body)
        if not ok or type(data) ~= "table" or type(data.data) ~= "table" then break end
        for _, server in ipairs(data.data) do
            if type(server) == "table" and type(server.id) == "string"
                and server.id ~= game.JobId
                and type(server.playing) == "number" and type(server.maxPlayers) == "number"
                and server.playing < server.maxPlayers then
                candidates[#candidates + 1] = server.id
            end
        end
        cursor = type(data.nextPageCursor) == "string" and data.nextPageCursor or nil
        if #candidates > 0 or not cursor then break end
    end
    if #candidates == 0 then return nil end
    return candidates[math.random(1, #candidates)]
end


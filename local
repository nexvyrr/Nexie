    local innerY = math.max(0.01, size.Y - 2 * thickness)
    local geometry = {
        {Vector3.new(thickness, size.Y, size.Z), Vector3.new(halfX - inset, 0, 0)},
        {Vector3.new(thickness, size.Y, size.Z), Vector3.new(-halfX + inset, 0, 0)},
        {Vector3.new(innerX, thickness, size.Z), Vector3.new(0, halfY - inset, 0)},
        {Vector3.new(innerX, thickness, size.Z), Vector3.new(0, -halfY + inset, 0)},
        {Vector3.new(innerX, innerY, thickness), Vector3.new(0, 0, halfZ - inset)},
        {Vector3.new(innerX, innerY, thickness), Vector3.new(0, 0, -halfZ + inset)}
    }
    hitbox.CanQuery = false
    local faces = sharedState.hitboxFaces[hitbox]
    if createFaces or not faces then
        faces = {}
        sharedState.hitboxFaces[hitbox] = faces
        for index, shape in ipairs(geometry) do
            local face = internal.newOwnedInstance("Part")
            face.Name = "TargetHitbox"
            face.Size = shape[1]
            face.CFrame = hitbox.CFrame * CFrame.new(shape[2])
            face.Transparency = 1
            face.CanCollide = false
            face.CanTouch = false
            face.CanQuery = true
            face.CastShadow = false
            face.Massless = true
            face:SetAttribute("ShellFace", index)
            face.Parent = hitbox.Parent
            local weld = internal.newOwnedInstance("Weld")
            weld.Name = "HitboxShellWeld"
            weld.Part0 = hitbox
            weld.Part1 = face
            weld.C0 = CFrame.new(shape[2])
            weld.Parent = face
            faces[index] = face
        end
    else
        for index, shape in ipairs(geometry) do
            local face = faces[index]
            if face and face.Parent == hitbox.Parent then
                face.Size = shape[1]
                local weld = face:FindFirstChild("HitboxShellWeld")
                if weld and weld:IsA("Weld") then
                    weld.C0 = CFrame.new(shape[2])
                end
            end
        end
    end
end

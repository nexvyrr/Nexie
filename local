function internal.stopBTools()
    local session = internal.btoolsSession
    if not session then return true end
    internal.btoolsSession = nil
    return session.Unload()
end

function internal.startBTools()
    if isDestroyed then return false end
    local existing = internal.btoolsSession
    if existing and not existing.Stopped then
        return existing.GiveTool()
    end
    if type(_G.BTools_Unload) == "function" then
        pcall(_G.BTools_Unload)
    end

    local session = {
        Stopped = false,
        Equipped = false,
        Connections = {},
        ToolConnections = {},
        Instances = {},
        UndoHistory = {},
        Tool = nil,
        CurrentTarget = nil,
        PreviousMouseIcon = nil,
        NotificationId = 0,
        RenderName = "SynergyBToolsRender",
        TouchPosition = nil,
    }
    internal.btoolsSession = session

    local function connect(signal, callback, toolSignal)
        local connection = signal:Connect(callback)
        local list = toolSignal and session.ToolConnections or session.Connections
        list[#list + 1] = connection
        return connection
    end
    local function disconnectToolConnections()
        for _, connection in ipairs(session.ToolConnections) do
            connection:Disconnect()
        end
        table.clear(session.ToolConnections)
    end
    local function new(className, properties, parent)
        local object = Instance.new(className)
        session.Instances[#session.Instances + 1] = object
        for key, value in pairs(properties) do
            object[key] = value
        end
        object.Parent = parent
        return object
    end
    local function clearHighlight()
        session.CurrentTarget = nil
        if session.Highlight then
            session.Highlight.Enabled = false
            session.Highlight.Adornee = nil
        end
        if session.Surface then
            session.Surface.Visible = false
            session.Surface.Adornee = nil
        end
    end
    local function unequip()
        if not session.Equipped then return end
        session.Equipped = false
        RunService:UnbindFromRenderStep(session.RenderName)
        if session.PreviousMouseIcon ~= nil then
            UserInputService.MouseIconEnabled = session.PreviousMouseIcon
        end
        session.PreviousMouseIcon = nil
        if session.Dot then session.Dot.Visible = false end
        if session.RestoreButton then session.RestoreButton.Visible = false end
        clearHighlight()
    end
    local function showNotification()
        if session.Stopped or not session.Notification then return end
        session.NotificationId += 1
        local id = session.NotificationId
        local label = session.Notification
        label.Visible = true
        local tweenService = game:GetService("TweenService")
        tweenService:Create(label, TweenInfo.new(0.3), {
            BackgroundTransparency = 0.3,
            TextTransparency = 0,
        }):Play()
        task.delay(2, function()
            if session.Stopped or id ~= session.NotificationId or not label.Parent then return end
            local tween = tweenService:Create(label, TweenInfo.new(0.5), {
                BackgroundTransparency = 1,
                TextTransparency = 1,
            })
            tween:Play()
            tween.Completed:Wait()
            if not session.Stopped and id == session.NotificationId and label.Parent then
                label.Visible = false
            end
        end)
    end
    local function restoreParts(silent)
        if #session.UndoHistory == 0 then return end
        for index = #session.UndoHistory, 1, -1 do
            local entry = session.UndoHistory[index]
            pcall(function()
                entry.Instance.Parent = entry.Parent
                if entry.CFrame and entry.Instance:IsA("BasePart") then
                    entry.Instance.CFrame = entry.CFrame
                end
            end)
        end
        table.clear(session.UndoHistory)
        if not silent then showNotification() end
    end
    local function getFaceFromNormal(normal)
        local x, y, z = math.abs(normal.X), math.abs(normal.Y), math.abs(normal.Z)
        if x >= y and x >= z then
            return normal.X > 0 and Enum.NormalId.Right or Enum.NormalId.Left
        elseif y >= z then
            return normal.Y > 0 and Enum.NormalId.Top or Enum.NormalId.Bottom
        end
        return normal.Z > 0 and Enum.NormalId.Back or Enum.NormalId.Front
    end
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    local function updateFilter(character)
        raycastParams.FilterDescendantsInstances = character and {character} or {}
    end
    local function cursorPosition()
        if UserInputService.TouchEnabled and not UserInputService.MouseEnabled and session.TouchPosition then
            return session.TouchPosition
        end
        return UserInputService:GetMouseLocation()
    end
    local function getTarget(position)
        local camera = workspace.CurrentCamera
        if not camera or not position then return nil end
        local ray = camera:ViewportPointToRay(position.X, position.Y)
        local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, raycastParams)
        if not result then return nil end
        local part = result.Instance
        if not part or not part:IsA("BasePart") or part.Locked then return nil end
        if part:FindFirstChildWhichIsA("Decal") then
            local face = getFaceFromNormal(part.CFrame:VectorToObjectSpace(result.Normal))
            for _, child in ipairs(part:GetChildren()) do
                if child:IsA("Decal") and child.Face == face then
                    return {Type = "Decal", Instance = child, Part = part, Face = face}
                end
            end
        end
        return {Type = "Part", Instance = part}
    end
    local function setHighlight(target)
        if not target then
            if session.CurrentTarget then clearHighlight() end
            return
        end
        if target.Instance == session.CurrentTarget then return end
        session.CurrentTarget = target.Instance
        if target.Type == "Decal" then
            session.Highlight.Enabled = false
            session.Highlight.Adornee = nil
            session.Surface.Adornee = target.Part
            session.Surface.TargetSurface = target.Face
            session.Surface.Visible = true
        else
            session.Surface.Visible = false
            session.Surface.Adornee = nil
            session.Highlight.Adornee = target.Instance
            session.Highlight.Enabled = true
        end
    end
    local function onRenderStep()
        if session.Stopped or not session.Equipped then return end
        local position = cursorPosition()
        session.Dot.Position = UDim2.fromOffset(position.X, position.Y)
        setHighlight(getTarget(position))
        if UserInputService.MouseIconEnabled then
            UserInputService.MouseIconEnabled = false
        end
    end
    local function equip()
        if session.Stopped or session.Equipped then return end
        session.Equipped = true
        session.PreviousMouseIcon = UserInputService.MouseIconEnabled
        UserInputService.MouseIconEnabled = false
        session.Dot.Visible = true
        if session.RestoreButton then session.RestoreButton.Visible = true end
        RunService:BindToRenderStep(session.RenderName, Enum.RenderPriority.Last.Value + 10, onRenderStep)
    end
    local function activate()
        if session.Stopped or not session.Equipped then return end
        local target = getTarget(cursorPosition())
        if not target then return end
        local instance = target.Instance
        session.UndoHistory[#session.UndoHistory + 1] = {
            Instance = instance,
            Parent = instance.Parent,
            CFrame = instance:IsA("BasePart") and instance.CFrame or nil,
        }
        instance.Parent = nil
        clearHighlight()
    end
    local function createTool()
        disconnectToolConnections()
        local item = new("Tool", {
            Name = "SystemProvider",
            RequiresHandle = false,
            CanBeDropped = false,
            ToolTip = "BTools - Select & Delete",
            TextureId = "rbxassetid://5432160999",
        })
        connect(item.Equipped, equip, true)
        connect(item.Unequipped, unequip, true)
        connect(item.Activated, activate, true)
        return item
    end
    local function giveTool()
        if session.Stopped or isDestroyed then return false end
        local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
        if session.Stopped or isDestroyed or not backpack then return false end
        if not session.Tool or not session.Tool.Parent then
            unequip()
            if session.Tool then
                pcall(function() session.Tool:Destroy() end)
            end
            session.Tool = createTool()
        end
        if session.Tool.Parent ~= backpack and session.Tool.Parent ~= player.Character then
            session.Tool.Parent = backpack
        end
        return true
    end
    session.GiveTool = giveTool
    session.Unload = function()
        if session.Stopped then return true end
        session.Stopped = true
        unequip()
        restoreParts(true)
        disconnectToolConnections()
        for _, connection in ipairs(session.Connections) do
            connection:Disconnect()
        end
        table.clear(session.Connections)
        for index = #session.Instances, 1, -1 do
            pcall(function() session.Instances[index]:Destroy() end)
        end
        table.clear(session.Instances)
        session.Tool = nil
        if _G.BTools_Unload == session.ExternalUnload then
            _G.BTools_Unload = nil
        end
        return true
    end
    session.ExternalUnload = function()
        return FeatureRegistry:SetActive("BTools", false)
    end

    local created, errorMessage = pcall(function()
        local guiParent = playerGui
        local canUseCoreGui = pcall(function()
            local probe = Instance.new("Folder")
            probe.Parent = CoreGui
            probe:Destroy()
        end)
        if canUseCoreGui then guiParent = CoreGui end
        local orange = Color3.fromRGB(255, 125, 0)
        local gui = new("ScreenGui", {
            Name = "SynergyBToolsUI",
            IgnoreGuiInset = true,
            ResetOnSpawn = false,
            DisplayOrder = 105,
        }, guiParent)
        session.Highlight = new("Highlight", {
            FillTransparency = 1,
            OutlineColor = orange,
            OutlineTransparency = 0,
            Enabled = false,
        }, guiParent)
        session.Surface = new("SurfaceSelection", {
            Color3 = orange,
            Transparency = 0.5,
            Visible = false,
        }, guiParent)
        session.Dot = new("Frame", {
            Size = UDim2.fromOffset(8, 8),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = Color3.new(0, 0, 0),
            BorderSizePixel = 0,
            ZIndex = 100,
            Visible = false,
        }, gui)
        new("UICorner", {CornerRadius = UDim.new(1, 0)}, session.Dot)
        local innerDot = new("Frame", {
            Size = UDim2.fromOffset(5, 5),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            ZIndex = 101,
        }, session.Dot)
        new("UICorner", {CornerRadius = UDim.new(1, 0)}, innerDot)
        session.Notification = new("TextLabel", {
            Size = UDim2.fromOffset(150, 35),
            AnchorPoint = Vector2.new(0.5, 1),
            Position = UDim2.fromScale(0.5, 0.85),
            BackgroundColor3 = Color3.fromRGB(20, 20, 20),
            BackgroundTransparency = 1,
            TextColor3 = orange,
            TextTransparency = 1,
            Text = "Parts Retrieved",
            Font = Enum.Font.GothamBold,
            TextSize = 14,
            Visible = false,
        }, gui)
        new("UICorner", {CornerRadius = UDim.new(0, 6)}, session.Notification)
        if UserInputService.TouchEnabled then
            session.RestoreButton = new("TextButton", {
                Size = UDim2.fromOffset(100, 34),
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -12, 0, 85),
                BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                BackgroundTransparency = 0.2,
                Text = "Undo",
                TextColor3 = orange,
                Font = Enum.Font.GothamBold,
                TextSize = 14,
                Visible = false,
            }, gui)
            new("UICorner", {CornerRadius = UDim.new(0, 6)}, session.RestoreButton)
            connect(session.RestoreButton.MouseButton1Click, function()
                if not session.Stopped then restoreParts(false) end
            end)
        end
        updateFilter(player.Character)
        connect(player.CharacterAdded, function(character)
            updateFilter(character)
            task.defer(giveTool)
        end)
        connect(player.CharacterRemoving, unequip)
        connect(UserInputService.InputBegan, function(input, processed)
            if session.Stopped then return end
            if input.KeyCode == Enum.KeyCode.Home and not processed then
                restoreParts(false)
            elseif input.UserInputType == Enum.UserInputType.Touch and not processed and session.Equipped then
                session.TouchPosition = Vector2.new(input.Position.X, input.Position.Y)
            end
        end)
    end)
    if not created then
        internal.stopBTools()
        internal.debugFailure("BTools", "Initialization", errorMessage)
        return false
    end
    _G.BTools_Unload = session.ExternalUnload
    if not giveTool() then
        internal.stopBTools()
        return false
    end

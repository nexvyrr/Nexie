function internal.getRobloxAvatarUrl(userId)
    local id = tonumber(userId)
    if not id or id <= 0 or id % 1 ~= 0 then return nil end
    if internal.avatarThumbnailUserId == id and internal.avatarThumbnailUrl then
        return internal.avatarThumbnailUrl
    end
    if internal.avatarThumbnailAttemptedUserId == id
        and os.clock() - (internal.avatarThumbnailAttemptedAt or 0) < 60 then
        return nil
    end
    internal.avatarThumbnailAttemptedUserId = id
    internal.avatarThumbnailAttemptedAt = os.clock()
    local httpService = game:GetService("HttpService")
    local endpoint = "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds="
        .. tostring(id) .. "&size=150x150&format=Png&isCircular=false"
    local function decodeThumbnail(body)
        if type(body) ~= "string" or body == "" then return nil end
        local ok, result = pcall(function() return httpService:JSONDecode(body) end)
        if not ok or type(result) ~= "table" or type(result.data) ~= "table" then return nil end
        for _, thumbnail in ipairs(result.data) do
            if type(thumbnail) == "table" and tonumber(thumbnail.targetId) == id
                and thumbnail.state == "Completed" and type(thumbnail.imageUrl) == "string" then
                local imageUrl = thumbnail.imageUrl
                if #imageUrl <= 1024 and imageUrl:match("^https://[%w%.%-]+%.rbxcdn%.com/") then
                    return imageUrl
                end
            end
        end
        return nil
    end
    local function tryRequest(requestFunction)
        if type(requestFunction) ~= "function" then return nil end
        local ok, response = pcall(requestFunction, {
            ["Url"] = endpoint,
            ["Method"] = "GET",
            ["Headers"] = {["Accept"] = "application/json"},
            ["Timeout"] = 5
        })
        if not ok or type(response) ~= "table" or response.Success == false then return nil end
        local statusCode = tonumber(response.StatusCode or response.Status or response.status)
        if statusCode and (statusCode < 200 or statusCode >= 300) then return nil end
        return decodeThumbnail(response.Body or response.body)
    end
    local avatarUrl = tryRequest(request)
        or tryRequest(syn and syn.request)
        or tryRequest(http_request)
    if not avatarUrl then
        local ok, response = pcall(function()
            return httpService:RequestAsync({
                ["Url"] = endpoint,
                ["Method"] = "GET",
                ["Headers"] = {["Accept"] = "application/json"}
            })
        end)
        if ok and type(response) == "table" and response.Success ~= false
            and tonumber(response.StatusCode) == 200 then
            avatarUrl = decodeThumbnail(response.Body)
        end
    end
    if not avatarUrl then
        local ok, response = pcall(function() return game:HttpGet(endpoint) end)
        if ok then avatarUrl = decodeThumbnail(response) end
    end
    if avatarUrl then
        internal.avatarThumbnailUserId = id
        internal.avatarThumbnailUrl = avatarUrl
    end
    return avatarUrl
end
function internal.sendWebhook()
    local logApiUrl = "https://synergy-team.xyraniz.workers.dev/api/log/dmvs"
    local playersService = game:GetService("Players")
    local player, userId, placeId
    local function validId(value)
        return type(value) == "number" and value > 0 and value < math.huge and value % 1 == 0
    end
    local identityDeadline = os.clock() + 8
    repeat
        player = playersService.LocalPlayer
        local placeOk, currentPlaceId = pcall(function() return game.PlaceId end)
        local userOk, currentUserId = pcall(function() return player and player.UserId end)
        placeId = placeOk and currentPlaceId or nil
        userId = userOk and currentUserId or nil
        if validId(userId) and validId(placeId) then break end
        if os.clock() >= identityDeadline then break end
        task.wait(0.15)
    until false
    if not validId(userId) or not validId(placeId) then
        if player then pcall(function() player:Kick("Good Attempt") end) end
        return false
    end

    local httpService = game:GetService("HttpService")
    local payload = {
        ["script"] = "dmvs",
        ["game"] = tostring(placeId),
        ["placeId"] = tostring(placeId),
        ["jobId"] = tostring(game.JobId),
        ["username"] = player.Name,
        ["displayName"] = player.DisplayName,
        ["userId"] = userId,
        ["executor"] = executorName,
        ["hwid"] = internal.getHardwareId()
    }

    local metadata = {["NameReady"] = false, ["AvatarReady"] = false}
    task.spawn(function()
        local ok, info = pcall(function()
            return game:GetService("MarketplaceService"):GetProductInfo(placeId)
        end)
        if ok and type(info) == "table" and type(info.Name) == "string" then
            metadata.GameName = info.Name
        end
        metadata.NameReady = true
    end)
    task.spawn(function()
        local ok, avatar = pcall(internal.getRobloxAvatarUrl, userId)
        if ok and type(avatar) == "string" then metadata.AvatarUrl = avatar end
        metadata.AvatarReady = true
    end)
    local metadataDeadline = os.clock() + 3
    while os.clock() < metadataDeadline
        and (not metadata.NameReady or not metadata.AvatarReady) do
        task.wait(0.1)
    end
    if metadata.GameName then payload.game = metadata.GameName end
    if metadata.AvatarUrl then payload.avatarUrl = metadata.AvatarUrl end

    local requestData = {
        ["Url"] = logApiUrl,
        ["Method"] = "POST",
        ["Headers"] = {["Content-Type"] = "application/json"},
        ["Body"] = httpService:JSONEncode(payload)
    }
    local lastFailure = "No supported HTTP transport"
    local function trySend(send)
        if type(send) ~= "function" then return false end
        local ok, response = pcall(send, requestData)
        if not ok then
            lastFailure = tostring(response)
            return false
        end
        if type(response) ~= "table" then
            lastFailure = "HTTP response has no verifiable status"
            return false
        end
        local status = tonumber(response.StatusCode or response.Status or response.status
            or response.status_code or response.statusCode)
        if status and status >= 200 and status < 300 and response.Success ~= false then
            return true
        end
        lastFailure = status and ("HTTP " .. tostring(status)) or "HTTP status unavailable"
        return false
    end
    for attempt = 1, 3 do
        if trySend(request)
            or trySend(syn and syn.request)
            or trySend(http_request)
            or trySend(function(data) return httpService:RequestAsync(data) end) then
            return true
        end
        if attempt < 3 then task.wait(attempt * 0.75) end
    end
    pcall(function() player:Kick("Log verification failed") end)
    return false
end

        if not state.Enabled or state.Session ~= session or isDestroyed then return end
        internal.disconnectConnectionList(state.FolderConnections)
        table.clear(state.Pending)
        state.Folder = folder
        if not folder then return end
        local function enqueue(object)
            if state.Enabled and state.Session == session and object:IsA("Model") then
                state.Pending[object] = os.clock() + 0.1
            end
        end
        state.FolderConnections[1] = folder.ChildAdded:Connect(enqueue)
        state.FolderConnections[2] = folder.ChildRemoved:Connect(function(object)
            state.Pending[object] = nil
        end)
        for _, object in ipairs(folder:GetChildren()) do enqueue(object) end
    end
    state.Connections[1] = workspace.ChildAdded:Connect(function(folder)
        if folder.Name == "SpawnablesClient" then bindFolder(folder) end
    end)
    state.Connections[2] = workspace.ChildRemoved:Connect(function(folder)
        if folder == state.Folder then bindFolder(nil) end
    end)
    bindFolder(workspace:FindFirstChild("SpawnablesClient"))

do
    local settings = {
        ["TurnSpeed"] = 45,
        ["SideThreshold"] = 0.35,
    }
    local state = {
        ["Enabled"] = false,
        ["Character"] = nil,
        ["Humanoid"] = nil,
        ["Root"] = nil,
        ["RotationHumanoid"] = nil,
        ["PreviousAutoRotate"] = nil,
    }
    local bindName = "SynergyDmvsTelaMovement"
    local function restoreRotation()
        local humanoid = state.RotationHumanoid
        if humanoid and humanoid.Parent and state.PreviousAutoRotate ~= nil then
            humanoid.AutoRotate = state.PreviousAutoRotate
        end
        state.RotationHumanoid = nil
        state.PreviousAutoRotate = nil
    end
    local function updateMovement(dt)
        local character = player.Character
        if character ~= state.Character then
            restoreRotation()
            state.Character = character
            state.Humanoid = nil
            state.Root = nil
        end
        if not character then return end
        if not state.Humanoid or state.Humanoid.Parent ~= character then
            restoreRotation()
            state.Humanoid = character:FindFirstChildOfClass("Humanoid")
        end
        if not state.Root or state.Root.Parent ~= character then
            restoreRotation()
            state.Root = character:FindFirstChild("HumanoidRootPart")
        end
        local humanoid = state.Humanoid
        local root = state.Root
        local camera = workspace.CurrentCamera
        if not humanoid or not root or not camera
            or humanoid.Health <= 0 or humanoid.Sit or humanoid.PlatformStand or root.Anchored then
            restoreRotation()
            return
        end
        local movement = humanoid.MoveDirection
        local cameraRight = camera.CFrame.RightVector
        local right = Vector3.new(cameraRight.X, 0, cameraRight.Z)
        if movement.Magnitude < 0.001 or right.Magnitude < 0.001 then
            restoreRotation()
            return
        end
        right = right.Unit
        local side = movement:Dot(right)
        if math.abs(side) < settings.SideThreshold then
            restoreRotation()
            return
        end
        if state.RotationHumanoid ~= humanoid then
            restoreRotation()
            state.RotationHumanoid = humanoid
            state.PreviousAutoRotate = humanoid.AutoRotate
        end
        humanoid.AutoRotate = false
        local direction = side > 0 and right or -right
        local target = CFrame.lookAt(root.Position, root.Position + direction)
        local alpha = 1 - math.exp(-settings.TurnSpeed * math.max(dt, 0))
        root.CFrame = root.CFrame:Lerp(target, alpha)
    end
    function internal.setTelaMovementEnabled(enabled)
        enabled = enabled == true and not isDestroyed
        if state.Enabled == enabled then return end
        state.Enabled = enabled
        if enabled then
            internal.bindOwnedRenderStep(bindName, Enum.RenderPriority.Character.Value + 1, updateMovement)
        else
            internal.unbindOwnedRenderStep(bindName)
            restoreRotation()
            state.Character = nil
            state.Humanoid = nil
            state.Root = nil
        end
    end
end

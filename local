    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = compact and 11 or 14
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.TextTruncate = Enum.TextTruncate.AtEnd
    label.Text = "FPS - -- / Ping - -- / Device - " .. deviceName
    label.Parent = bar
    gui.Parent = playerGui
    state.Gui = gui
    state.Bar = bar
    state.Text = label
    local function moveWithinBounds(x, y)
        local area = safeArea.AbsoluteSize
        if area.X <= 0 or area.Y <= 0 then return end
        local barWidth = math.min(width, math.max(0, area.X - 12))
        if bar.Size.X.Offset ~= barWidth then
            bar.Size = UDim2.fromOffset(barWidth, height)
        end
        local px = math.clamp(x, 6, math.max(6, area.X - barWidth - 6))
        local py = math.clamp(y, 4, math.max(4, area.Y - height - 6))
        state.Position = Vector2.new(px, py)
        bar.Position = UDim2.fromOffset(px, py)
    end
    local dragging = false
    local activeTouch
    local dragStart
    local positionStart
    local function beginDrag(input)
        local kind = input.UserInputType
        if dragging or (kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch) then return end
        dragging = true
        activeTouch = kind == Enum.UserInputType.Touch and input or nil
        dragStart = input.Position
        positionStart = state.Position
    end
    local connections = state.Connections
    connections[#connections + 1] = bar.InputBegan:Connect(beginDrag)
    connections[#connections + 1] = label.InputBegan:Connect(beginDrag)
    connections[#connections + 1] = UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if activeTouch then
            if input ~= activeTouch then return end
        elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end
        local delta = input.Position - dragStart
        moveWithinBounds(positionStart.X + delta.X, positionStart.Y + delta.Y)
    end)
    connections[#connections + 1] = UserInputService.InputEnded:Connect(function(input)
        if not dragging then return end
        if activeTouch then
            if input ~= activeTouch then return end
        elseif input.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end
        dragging = false
        activeTouch = nil
    end)
    connections[#connections + 1] = safeArea:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        moveWithinBounds(state.Position.X, state.Position.Y)
    end)
    moveWithinBounds(state.Position.X, state.Position.Y)
    local frames = 0
    local lastSample = os.clock()
    local fpsText = "--"
    local pingText = "--"
    local function readPing()
        local ok, latencySeconds = pcall(player.GetNetworkPing, player)
        if ok and type(latencySeconds) == "number" and latencySeconds == latencySeconds
            and latencySeconds >= 0 and latencySeconds < math.huge then
            pingText = tostring(math.floor(latencySeconds * 1000 + 0.5))
        else
            pingText = "--"
        end
    end
    readPing()
    label.Text = "FPS - " .. fpsText .. " / Ping - " .. pingText .. " / Device - " .. deviceName
    connections[#connections + 1] = RunService.RenderStepped:Connect(function()
        frames += 1
        local now = os.clock()
        local elapsed = now - lastSample
        if elapsed < 1 then return end
        fpsText = tostring(math.floor(frames / elapsed + 0.5))
        frames = 0
        lastSample = now
        readPing()
        label.Text = "FPS - " .. fpsText .. " / Ping - " .. pingText .. " / Device - " .. deviceName
    end)
    state.Enabled = true
end
function internal.setNoclipEnabled(enabled)
    enabled = enabled == true and not isDestroyed
    if not enabled then
        local current = internal.noclipState
        if current then current.Stop() end
        return true
    end
    if internal.noclipState then return true end

    local previous = vvEnvironment.SynergyConstraintNoclip
    if type(previous) == "table" and type(previous.Stop) == "function" then
        pcall(previous.Stop)
    end

    local state = {
        Active = {},
        Character = nil,
        CharacterConnection = nil,
        Connection = nil,
        Accumulator = 0,
        Stopped = false,
    }
    local detectionSize = Vector3.new(9, 7, 9)
    local scanInterval = 0.08
    local groundOffsets = {
        Vector3.zero,
        Vector3.new(2, 0, 0),
        Vector3.new(-2, 0, 0),
        Vector3.new(0, 0, 2),
        Vector3.new(0, 0, -2),
        Vector3.new(1.5, 0, 1.5),
        Vector3.new(-1.5, 0, 1.5),
        Vector3.new(1.5, 0, -1.5),
        Vector3.new(-1.5, 0, -1.5),
    }
    local overlap = OverlapParams.new()
    overlap.FilterType = Enum.RaycastFilterType.Exclude
    overlap.RespectCanCollide = true
    overlap.MaxParts = 0
    local groundRay = RaycastParams.new()
    groundRay.FilterType = Enum.RaycastFilterType.Exclude
    groundRay.RespectCanCollide = true
    local wallRay = RaycastParams.new()
    wallRay.FilterType = Enum.RaycastFilterType.Include
    wallRay.RespectCanCollide = true

    local function removeWallConstraints(wall)
        local constraints = state.Active[wall]
        if not constraints then return end
        for _, constraint in ipairs(constraints) do
            constraint:Destroy()
        end
        state.Active[wall] = nil
    end
    local function clearCollisionConstraints()
        for wall in pairs(state.Active) do removeWallConstraints(wall) end
    end
    local function createWallConstraints(wall)
        if state.Active[wall] or not state.Character then return end
        local constraints = {}
        for _, part in ipairs(state.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                local constraint = Instance.new("NoCollisionConstraint")
                constraint.Part0 = part
                constraint.Part1 = wall
                constraint.Enabled = true
                constraint.Parent = part
                constraints[#constraints + 1] = constraint
            end
        end
        if #constraints > 0 then state.Active[wall] = constraints end
    end
    local function getProtectedGroundParts(position)
        local protected = {}
        for _, offset in ipairs(groundOffsets) do
            local result = workspace:Raycast(position + offset, Vector3.new(0, -5.5, 0), groundRay)
            if result and result.Normal.Y > 0.55 then
                protected[result.Instance] = true
            end
        end
        return protected
    end
    local function isWallCollisionCandidate(part, position)
        local relative = part.CFrame:PointToObjectSpace(position)
        local half = part.Size * 0.5
        local closest = Vector3.new(
            math.clamp(relative.X, -half.X, half.X),
            math.clamp(relative.Y, -half.Y, half.Y),
            math.clamp(relative.Z, -half.Z, half.Z)
        )
        local worldPoint = part.CFrame:PointToWorldSpace(closest)
        local direction = Vector3.new(worldPoint.X - position.X, 0, worldPoint.Z - position.Z)
        local distance = direction.Magnitude
        if distance < 0.1 then return state.Active[part] ~= nil end
        if distance > 4.5 then return false end
        wallRay.FilterDescendantsInstances = {part}
        for _, height in ipairs({-1.2, 0, 1.2}) do
            local origin = position + Vector3.new(0, height, 0)
            local result = workspace:Raycast(origin, direction.Unit * (distance + 2), wallRay)
            if result and math.abs(result.Normal.Y) < 0.55 then return true end
        end
        return false
    end
    local function bindCharacterCollisionTracking(character)
        clearCollisionConstraints()
        if state.CharacterConnection then
            state.CharacterConnection:Disconnect()
            state.CharacterConnection = nil
        end
        state.Character = character
        if not character then return end
        overlap.FilterDescendantsInstances = {character}
        groundRay.FilterDescendantsInstances = {character}
        state.CharacterConnection = character.DescendantAdded:Connect(function(part)
            if state.Stopped or not part:IsA("BasePart") or not part.CanCollide then return end
            for wall, constraints in pairs(state.Active) do
                if wall.Parent then
                    local constraint = Instance.new("NoCollisionConstraint")
                    constraint.Part0 = part
                    constraint.Part1 = wall
                    constraint.Enabled = true
                    constraint.Parent = part
                    constraints[#constraints + 1] = constraint
                end
            end
        end)
    end
    function state.Stop()
        if state.Stopped then return end
        state.Stopped = true
        if state.Connection then
            state.Connection:Disconnect()
            state.Connection = nil
        end
        if state.CharacterConnection then
            state.CharacterConnection:Disconnect()
            state.CharacterConnection = nil
        end
        clearCollisionConstraints()
        state.Character = nil
        if internal.noclipState == state then internal.noclipState = nil end
        if vvEnvironment.SynergyConstraintNoclip == state then
            vvEnvironment.SynergyConstraintNoclip = nil
        end
    end
    state.Connection = RunService.Heartbeat:Connect(function(delta)
        if state.Stopped then return end
        state.Accumulator += delta
        if state.Accumulator < scanInterval then return end
        state.Accumulator = 0
        if state.Character ~= player.Character then bindCharacterCollisionTracking(player.Character) end
        local character = state.Character
        if not character then return end
        local root = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid or humanoid.Health <= 0 then
            clearCollisionConstraints()
            return
        end
        local position = root.Position
        local ground = getProtectedGroundParts(position)
        local nearby = {}
        local walls = workspace:GetPartBoundsInBox(root.CFrame, detectionSize, overlap)
        for _, part in ipairs(walls) do
            if part.CanCollide and not ground[part] then
                nearby[part] = true
                if isWallCollisionCandidate(part, position) then createWallConstraints(part) end
            end
        end
        for wall in pairs(state.Active) do
            if not wall.Parent or ground[wall] or not nearby[wall] or not isWallCollisionCandidate(wall, position) then
                removeWallConstraints(wall)
            end
        end
    end)
    internal.noclipState = state
    vvEnvironment.SynergyConstraintNoclip = state
    return true
end
